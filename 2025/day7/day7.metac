function main() {
  const result = sumBeams() or catch(e) {
    log("Error! ${e}")
    return 1
  }
  log("Result: ${result}")
}

function sumBeams(): number | error {
  let grid: matrix(string) with dim(2) = []

  for const row in STDIN.split("\n")? {
    for const c in row.chars() { 
      grid.insert(c, [row.index(), c.index()])?
    }
  }
  
  const startCol = findStartCol(grid)
  let activeCols: int[] = [startCol]
  let row = 1
  let splits = 0

  while row < grid.size(0) {
    let next: int[] = []

    for const col in activeCols {
      if col < 0 || col >= grid.size(1) { continue }

      const cell = grid.at([row, col])
      if cell == "^" {
        next = pushUnique(next, col - 1)
        next = pushUnique(next, col + 1)
        splits++
      } else {
        next = pushUnique(next, col)
      }
    }
    
    activeCols = next
    row++
  }
  
  return splits
}

function findStartCol(grid: matrix(string) with dim(2)): number {
  for const x in seq(0, grid.size(1)-1) {
    if grid.at([0, x]) == "S" {
      return x
    }
  }
}

function pushUnique(xs: number[], value: number): number[] {
  let out = xs
  if out.any(x => x == value) {
    return out
  }
  out.push(value)
  return out
}