function main() {
  const result = sumBeams() or catch(e) {
    log("Error! ${e}")
    return 1
  }
  log("Result: ${result}")
}

function sumBeams(): number | error {
  let grid: matrix(string) with dim(2) = []

  for const row in STDIN.split("\n")? {
    for const c in row.chars() { 
      grid.insert(c, [row.index(), c.index()])?
    }
  }
  
  const startCol = findStartCol(grid)
  
  let rowPointer = 1
  let next: (int[] with size(2))[] = [[rowPointer, startCol]]
  let splits = 0

  while true {
    if rowPointer == grid.size(0) {
        break
    }
    
    for const i in seq(0, next.size()-1) {
        const [row,col] = next[i]
        [row,col].log()
        if grid.at(next[i]) == "." {
            next.insert([row+1,col], i)
        } else {
            const left = [row+1,col-1]
            const right = [row+1,col+1]
            next.insert(left, i)
            next.push(right)
            log("split <->")
            splits++
        }
        rowPointer = max(rowPointer, row+1)
    }
  }
  
  return splits
}

function findStartCol(grid: matrix(string) with dim(2)): number {
  for const x in seq(0, grid.size(1)-1) {
    if grid.at([0, x]) == "S" {
      return x
    }
  }
}